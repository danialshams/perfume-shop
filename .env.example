NODE_ENV=development
APP_NAME=Perfume Shop
APP_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=perfume_shop
DB_USER=root
DB_PASSWORD=

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Private media: configure these on Vercel for Preview and Production.
# S3_ENDPOINT must be the HTTPS API endpoint root (path-style /bucket/key).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Cloud MySQL settings (configure in Vercel project settings, NEVER commit values).
# A hosted Vercel function cannot reach 127.0.0.1 on your own computer.
# Set DB_HOST to a PUBLICLY REACHABLE hosted MySQL/MariaDB endpoint.
# DB_SSL_MODE=required enforces certificate validation; provide DB_SSL_CA for private CAs.
DB_SSL_MODE=disabled
DB_POOL_LIMIT=4
# DB_SSL_CA=your_ca_certificate_with_escaped_newlines
