NODE_ENV=development
APP_NAME=Perfume Shop
APP_URL=http://localhost:3000

# Portable PostgreSQL connection (Neon / Supabase / any hosted PostgreSQL / self-hosted).
# Set only in secure hosting environment. Never commit actual credentials.
DATABASE_URL=

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Private media: configure these on Vercel for Preview and Production.
# S3_ENDPOINT must be the HTTPS API endpoint root (path-style /bucket/key).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# PostgreSQL connection pool limit, adjust for the provider / host plan.
DB_POOL_LIMIT=4

# For the one-time initial administrator flow (set only during setup; rotate/remove afterward).
FERTINI_BOOTSTRAP_TOKEN=
